---
import CloudLandingPage from '@/components/cloud-landing-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = 'AnyTTY Cloud provides managed endpoint discovery, P2P negotiation, and encrypted Relay fallback for persistent terminals behind NAT.'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AnyTTY Cloud',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows, Android, iOS',
  description,
  offers: [
    { '@type': 'Offer', name: 'Cloud Free', price: '0', priceCurrency: 'CNY' },
    { '@type': 'Offer', name: 'Personal Pro monthly', price: '68', priceCurrency: 'CNY' },
    { '@type': 'Offer', name: 'Power User monthly', price: '138', priceCurrency: 'CNY' },
  ],
}
---

<BaseLayout locale="en" title="Cloud" description={description} pathname="/cloud/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <CloudLandingPage locale="en" />
</BaseLayout>
