---
import LandingPage from '@/components/landing-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = '开源跨平台终端复用器，提供持久会话、与 terminal 解耦的 panel、磁盘历史记录和跨 endpoint workspace。'
const structuredData = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AnyTTY', applicationCategory: 'DeveloperApplication', operatingSystem: 'Linux, macOS, Windows, Android, iOS', isAccessibleForFree: true, license: 'https://www.apache.org/licenses/LICENSE-2.0', codeRepository: 'https://github.com/anytty/anytty-site', downloadUrl: 'https://github.com/anytty/anytty-site/releases/tag/v0.0.1-beta.0' }
---

<BaseLayout locale="zh-CN" description={description} pathname="/zh-CN/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <LandingPage locale="zh-CN" />
</BaseLayout>
