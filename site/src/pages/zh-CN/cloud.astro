---
import CloudLandingPage from '@/components/cloud-landing-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const description = 'AnyTTY Cloud 为位于 NAT 或内网中的持久终端提供托管发现、P2P 协商和加密 Relay 兜底。'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AnyTTY Cloud',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows, Android, iOS',
  description,
  offers: [
    { '@type': 'Offer', name: 'Cloud Free', price: '0', priceCurrency: 'CNY' },
    { '@type': 'Offer', name: 'Personal Pro 月付', price: '68', priceCurrency: 'CNY' },
    { '@type': 'Offer', name: 'Power User 月付', price: '138', priceCurrency: 'CNY' },
  ],
}
---

<BaseLayout locale="zh-CN" title="Cloud" description={description} pathname="/zh-CN/cloud/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <CloudLandingPage locale="zh-CN" />
</BaseLayout>
