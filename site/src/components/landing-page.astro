    docs: 'Read the documentation', releases: 'Open GitHub Releases',
    platforms: ['macOS', 'Linux', 'Windows', 'Android', 'iOS'],
    openSource: 'Apache-2.0 · source, clients, and release artifacts on GitHub',
  },
  'zh-CN': {
    eyebrow: '开源 · 跨平台 · Multi-endpoint 终端复用器',
    promise: '一个工作台，管理每台机器上的终端。',
    lead: 'AnyTTY 在你的机器上维护持久终端。Shell、构建任务、服务和 AI Agent 不会因为窗口关闭而停止；TUI、CLI、Web 和手机 App 都能接入同一个终端现场。',
    quickStart: '看看工作原理', release: '下载 Beta',
