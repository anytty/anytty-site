const t = copy[locale]
const docsPath = sitePath(localizedPath(locale, '/docs/quick-start'))
const cloudDocsPath = sitePath(localizedPath(locale, '/docs/cloud'))
const releaseUrl = 'https://github.com/anytty/anytty-site/releases/tag/v0.0.1-beta.0'
const viewIcons = [PanelsTopLeft, TerminalSquare, Laptop, Smartphone]
const observerIcons = [Eye, ShieldCheck]
const workbenchIcons = [MonitorSmartphone, Laptop, Clock3]
const mobileIcons = [Clock3, TerminalSquare, FileStack]
const accessIcons = [Cloud, LockKeyhole, Files]
---

<main id="main" class="bg-background text-zinc-50">
  <div class="hero-cinematic -mt-20 pt-20">
    <section class="relative overflow-hidden px-5 pb-20 pt-24 text-center sm:px-8 sm:pt-32" aria-labelledby="product-title" data-hero>
      <div class="mx-auto max-w-4xl">
        <Badge variant="secondary" className="border-0 bg-[var(--chip)] px-3 py-1 font-mono text-[11px] font-normal text-zinc-200 shadow-none">
          {t.eyebrow}
        </Badge>
        <h1 id="product-title" class="mt-5 text-5xl font-medium leading-none tracking-tight sm:text-6xl">AnyTTY</h1>
        <p class="mt-5 text-2xl font-medium leading-snug text-zinc-100 sm:text-3xl">{t.promise}</p>
        <p class="mx-auto mt-5 max-w-3xl text-base font-normal leading-7 text-zinc-400 sm:text-lg sm:leading-8">{t.lead}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class={cn(buttonVariants({ variant: 'default', size: 'lg' }), 'h-11 px-5 font-normal')} href="#how-it-works">{t.quickStart}<ArrowRight aria-hidden="true" /></a>
          <a class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-11 border-[var(--line-strong)] bg-[var(--chip-soft)] px-5 font-normal text-zinc-100 hover:bg-[var(--chip)] hover:text-zinc-100')} href={releaseUrl}>{t.release}<ArrowDownToLine aria-hidden="true" /></a>
        </div>
      </div>
      <div class="hero-set relative mx-auto mt-12 w-full max-w-6xl [perspective:2400px]">
        <div class="hero-scroll-image group origin-bottom overflow-hidden rounded-2xl bg-zinc-900 shadow-2xl ring-1 ring-[var(--line)]" data-hero-image>
          <img class="block aspect-[2862/1870] w-full cursor-zoom-in object-cover" src={sitePath('/assets/product/tui-main.webp')} alt={t.previewAlt} width="2862" height="1870" data-image-preview data-image-preview-center data-preview-label={t.tuiLabel} />
        </div>
        <figure class="hero-device hero-device-phone hidden lg:block" style={{ '--hero-tilt': '-8deg' }}>
          <img class="block w-full rounded-xl bg-zinc-900 object-cover ring-1 ring-[var(--line-strong)]" src={sitePath('/assets/product/mobile-terminals.webp')} alt={t.mobileAlts[0]} width="480" height="1068" loading="lazy" />
        </figure>
        <figure class="hero-device hero-device-pad hidden lg:block" style={{ '--hero-tilt': '6deg' }}>
          <img class="block w-full rounded-xl bg-zinc-900 object-cover ring-1 ring-[var(--line-strong)]" src={sitePath('/assets/product/pad-codex-opencode.webp')} alt={t.tabletAlts[0]} width="1200" height="1600" loading="lazy" />
        </figure>
      </div>
    </section>
  </div>

  <section id="how-it-works" class="scroll-mt-20 py-20 sm:py-24 lg:py-28" aria-labelledby="observer-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-zinc-900/60 p-6 ring-1 ring-[var(--line)] sm:p-10 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div>
            <Badge variant="secondary" className="border-0 bg-[var(--chip)] font-mono text-[11px] font-normal text-zinc-200">{t.observerEyebrow}</Badge>
            <h2 id="observer-title" class="mt-5 text-3xl font-medium leading-tight sm:text-4xl">{t.observerTitle}</h2>
            <p class="mt-5 max-w-2xl text-base font-normal leading-7 text-zinc-400">{t.observerLead}</p>
            <div class="mt-8 grid gap-4">
              {t.observerPoints.map(([title, body], index) => {
                const Icon = observerIcons[index]
                return (
                  <div class="lift-card flex items-start gap-4 rounded-2xl bg-zinc-950 p-5 ring-1 ring-[var(--line)]">
                    <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-emerald-400/10 text-emerald-300"><Icon className="size-5" aria-hidden="true" /></span>
                    <div>
                      <h3 class="text-sm font-medium">{title}</h3>
                      <p class="mt-1 text-sm font-normal leading-6 text-zinc-400">{body}</p>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>

          <div class="relative min-h-[390px] overflow-hidden rounded-2xl bg-zinc-950 p-5 ring-1 ring-[var(--line)] sm:p-6" aria-label={t.observerTitle}>
            <div class="relative z-10 flex items-center justify-between gap-4 font-mono text-[10px] font-normal text-zinc-500 sm:text-[11px]">
              <span>{t.panelDiagram.views}</span>
              <span class="flex items-center gap-1.5 text-emerald-300"><Radio className="size-3" aria-hidden="true" />{t.panelDiagram.switch}</span>
            </div>

            <div class="relative z-10 mt-5 grid grid-cols-2 gap-4">
              {[[t.panelDiagram.panelA, t.panelDiagram.terminals[0]], [t.panelDiagram.panelB, t.panelDiagram.terminals[2]]].map(([panel, terminal], index) => (
