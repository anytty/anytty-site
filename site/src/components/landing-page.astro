    historyNote: 'Useful after a disconnect, an accidental exit, or an unattended agent run that produced hours of output.',
    historyDiagram: {
      stream: 'terminal output', live: 'live screen buffer', disk: 'history files on disk', bounded: 'bounded', growing: 'grows with retention',
      events: [['09:14', 'build started'], ['11:42', 'tests passed'], ['16:08', 'agent completed']],
    },
    mobileEyebrow: 'TUI · CLI · Web · Mobile', mobileTitle: 'Every client is a view into the same terminal runtime.',
    mobileLead: 'Use the keyboard-first TUI at your desk, automate through the CLI, or check in from web, phone, and tablet. Each client reads at its own pace without slowing the process inside the terminal.',
    mobilePoints: [
      ['Terminal activity at a glance', 'Scan running sessions and time since last output.'],
      ['Touch-ready controls', 'Use Esc, Ctrl, arrows, paging, and common terminal actions.'],
      ['Files and previews', 'Browse, upload, download, and preview remote files.'],
