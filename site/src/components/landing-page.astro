    ],
    cloudEyebrow: '可选付费服务', cloudTitle: 'AnyTTY Cloud 让内网 endpoint 更容易抵达。',
    cloudLead: '开源核心仍可免费通过 Local、SSH 或 Direct 独立使用。需要托管的设备发现、P2P 协商和加密 Relay 兜底时，再按需使用 Cloud。',
    cloudFunding: 'Cloud 订阅收入会用于 AnyTTY 开源核心的持续开发与维护。',
    cloudFeatures: [['设备发现', '找到已经配对的 endpoint'], ['P2P 优先', '条件允许时直接连接'], ['加密 Relay', 'NAT 阻断直连时自动兜底']],
    cloudCta: '进入 AnyTTY Cloud', cloudDocs: '了解 Cloud 原理', cloudOptional: '开源核心始终可以独立使用',
    tabletAlts: ['平板上下分屏运行 Codex 与 OpenCode', '在平板 AnyTTY 终端内运行 TTT 编辑器'],
    compareEyebrow: '走出当前终端窗口', compareTitle: '一个跨越机器与屏幕的终端复用器。',
    compareLead: 'tmux 和 Zellij 很擅长在终端内维护持久会话。AnyTTY 在这一模型上进一步提供与视图解耦的 terminal、跨 endpoint workspace、官方外部客户端和远程文件工作流。',
    compareProducts: ['AnyTTY', 'tmux', 'Zellij', 'Windows Terminal'],
