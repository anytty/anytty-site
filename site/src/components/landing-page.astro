    workbenchEyebrow: 'Multi-endpoint workspace', workbenchTitle: 'One workspace can span every machine you use.',
    workbenchLead: 'Place local terminals beside sessions from workstations, build machines, servers, or other endpoints. They share one picker and one workspace, even when they run on different machines.',
