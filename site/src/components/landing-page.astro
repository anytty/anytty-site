const t = copy[locale]
const docsPath = sitePath(localizedPath(locale, '/docs/quick-start'))
const cloudDocsPath = sitePath(localizedPath(locale, '/docs/cloud'))
const releaseUrl = 'https://github.com/anytty/anytty-site/releases/tag/v0.0.1-beta.0'
const viewIcons = [PanelsTopLeft, TerminalSquare, Laptop, Smartphone]
---

<main id="main" class="bg-background text-zinc-50">
  <div class="hero-cinematic -mt-20 pt-20">
    <section class="relative overflow-hidden px-5 pb-16 pt-12 text-center sm:px-8 sm:pb-20 sm:pt-14" aria-labelledby="product-title" data-hero>
      <div class="mx-auto max-w-4xl">
        <Badge variant="secondary" className="border-0 bg-[var(--chip)] px-3 py-1 font-mono text-[11px] font-normal text-zinc-200 shadow-none">
          {t.eyebrow}
        </Badge>
        <h1 id="product-title" class="mt-4 text-5xl font-medium leading-none tracking-tight sm:text-[56px]">AnyTTY</h1>
        <p class="hero-slogan mx-auto mt-5 max-w-3xl text-base leading-snug text-zinc-300 sm:text-xl" aria-label="Any TTY. Any machine. Any client. Any task. Any time. That's AnyTTY.">
          <span class="hero-slogan-line">
            <span>Any TTY.</span><span>Any machine.</span><span>Any client.</span>
          </span>
          <span class="hero-slogan-line">
            <span>Any task.</span><span>Any time.</span><span class="hero-slogan-close">That's <strong>AnyTTY.</strong></span>
          </span>
        </p>
        <p class="mx-auto mt-4 max-w-4xl text-base font-normal leading-7 text-zinc-400 sm:text-lg sm:leading-8">{t.lead}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a class={cn(buttonVariants({ variant: 'default', size: 'lg' }), 'h-11 px-5 font-normal')} href="#how-it-works">{t.quickStart}<ArrowRight aria-hidden="true" /></a>
