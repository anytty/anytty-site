    cloudFeatures: [['Device discovery', 'Find your paired endpoints'], ['P2P first', 'Connect directly when possible'], ['Encrypted Relay', 'Fallback when NAT blocks the path']],
    cloudCta: 'Open AnyTTY Cloud', cloudDocs: 'How Cloud works', cloudOptional: 'The open-source core remains independently usable',
    tabletAlts: ['Tablet split screen running Codex and OpenCode', 'TTT editor running inside an AnyTTY terminal on a tablet'],
    compareEyebrow: 'Beyond one terminal window', compareTitle: 'A multiplexer that extends across machines and screens.',
    compareLead: 'tmux and Zellij are excellent at persistent sessions inside a terminal. AnyTTY builds on that model with view-independent terminals, multi-endpoint workspaces, first-party external clients, and remote file workflows.',
    compareProducts: ['AnyTTY', 'tmux', 'Zellij', 'Windows Terminal'],
    compareRows: [
      ['Persistent sessions · detach and reattach', true, true, true, false],
      ['Panels decoupled from terminal identity', true, false, false, false],
