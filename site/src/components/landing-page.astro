    mobileAlts: ['AnyTTY mobile terminal list with recent activity', 'AnyTTY mobile terminal with an extra-key row', 'AnyTTY mobile remote file manager'],
    accessEyebrow: 'Connection routes', accessTitle: 'Choose how each endpoint connects.',
    accessLead: 'Start locally, use SSH where it already fits, connect directly on networks you manage, or add optional AnyTTY Cloud for device discovery, P2P negotiation, and encrypted Relay fallback.',
    accessDiagram: { endpoint: 'Workspace client', routes: ['Local', 'SSH', 'Direct', 'Cloud'], daemon: 'Endpoint daemon' },
    accessPoints: [
      ['Local and SSH', 'Work on the same machine or reuse the OpenSSH access you already trust. No Cloud service is required.'],
      ['Direct and optional Cloud', 'Use a direct route on reachable networks, or let Cloud negotiate P2P and fall back to an encrypted Relay behind NAT.'],
      ['One authorized surface', 'Terminal input, screen output, and remote file operations use the same authenticated connection and daemon permissions.'],
    ],
    cloudEyebrow: 'Optional paid service', cloudTitle: 'AnyTTY Cloud makes private endpoints easy to reach.',
    cloudLead: 'Keep using the open-source core locally, over SSH, or with Direct connections for free. Add Cloud when you want managed device discovery, P2P negotiation, and encrypted Relay fallback.',
