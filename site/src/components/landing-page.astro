    historyEyebrow: '磁盘历史记录', historyTitle: '历史容量看磁盘，不看实时内存。',
    historyLead: '终端输出持续写入历史文件，每个在线客户端只保留有界的画面数据。历史记录没有固定行数上限，实际容量由可用磁盘空间和保留设置决定。',
    historyStats: [['实时内存', '有界'], ['历史容量', '看磁盘'], ['重新连接', '完整上下文']],
    historyNote: '断线、误关窗口，或者 Agent 跑了好几个小时，重新连上后还能看到完整现场。',
    historyDiagram: {
      stream: 'terminal 输出', live: '实时画面缓冲区', disk: '磁盘历史文件', bounded: '容量有界', growing: '随保留策略增长',
      events: [['09:14', '开始构建'], ['11:42', '测试通过'], ['16:08', 'Agent 完成']],
    },
    mobileEyebrow: 'TUI · CLI · Web · 手机 App', mobileTitle: '所有客户端，看到的是同一套终端运行时。',
