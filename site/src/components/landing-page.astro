---
import {
  ArrowDownToLine,
  ArrowRight,
  Check,
  CheckCircle2,
  Clock3,
  Cloud,
  Database,
  Eye,
  FileStack,
  Files,
  HardDrive,
  History,
  Laptop,
  LockKeyhole,
  Minus,
  MonitorSmartphone,
  PanelsTopLeft,
  Radio,
  Server,
  ShieldCheck,
  Smartphone,
  TerminalSquare,
} from 'lucide-react'

import { InstallTabs } from '@/components/install-tabs'
import { Badge } from '@/components/ui/badge'
import { buttonVariants } from '@/components/ui/button'
import { localizedPath, sitePath, type Locale } from '@/lib/site'
import { cn } from '@/lib/utils'

interface Props { locale: Locale }
const { locale } = Astro.props

const copy = {
  en: {
    eyebrow: 'Open source · cross-platform · multi-endpoint terminal multiplexer',
    promise: 'One workspace for every terminal, on every machine.',
    lead: 'AnyTTY keeps persistent terminal sessions on your machines. Shells, builds, servers, and coding agents survive closed windows, while the TUI, CLI, web, and mobile apps attach to the same sessions.',
    quickStart: 'See how it works', release: 'Download beta',
    installLabel: 'macOS / Linux', windowsInstallLabel: 'Windows', installPlatformLabel: 'Choose an installer',
    installCommand: 'curl -fsSL https://raw.githubusercontent.com/anytty/anytty-site/main/install.sh | sh',
    windowsCommand: 'irm https://raw.githubusercontent.com/anytty/anytty-site/main/install.ps1 -OutFile install.ps1; ./install.ps1',
    copyCommand: 'Copy install command', copied: 'Copied',
    previewLabel: 'A real AnyTTY workspace', previewMeta: 'local + remote · 5 terminals · one workspace',
