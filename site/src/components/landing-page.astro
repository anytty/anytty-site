    views: ['TUI panel', 'CLI', 'Web', '手机 App'],
    panelDiagram: {
      views: 'Workspace layout · 视图层', panelA: 'Panel A', panelB: 'Panel B', showing: '当前显示', switch: '切换 terminal',
      runtime: 'Daemon terminal runtime', terminals: [['term-01', '构建'], ['term-02', 'Agent'], ['term-03', '日志']], persistent: '进程始终在运行',
    },
    observerPoints: [
      ['换 terminal，不动 layout', '分屏、浮动 panel 和 workspace 的布局保持不变，每个 panel 可以随时切换到另一个 terminal。'],
      ['Terminal 不依赖任何视图', '关闭 TUI、断开客户端或换到另一台设备，daemon 持有的 terminal 及其中的进程仍会继续运行。'],
    ],
    workbenchEyebrow: '跨 endpoint 工作台', workbenchTitle: '一个 workspace，可以跨越你使用的每台机器。',
    workbenchLead: '把本机、工作站、构建机、服务器或其他 endpoint 上的 terminal 放在一起。即使运行在不同机器上，它们也共享同一个选择器和 workspace。',
