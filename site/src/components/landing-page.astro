<script>
  const hero = document.querySelector('[data-hero]')
  const image = hero?.querySelector<HTMLElement>('[data-hero-image]')
  if (hero && image) {
    let hoverScale = 1
    const apply = (withTransition: boolean) => {
      image.style.transition = withTransition ? 'transform 400ms ease' : 'none'
      const rect = hero.getBoundingClientRect()
      const progress = Math.min(Math.max(-rect.top / window.innerHeight, 0), 1)
      image.style.transform = `scale(${(1.04 - progress * 0.04) * hoverScale}) rotateX(${8 - progress * 8}deg) translateY(${progress * 2}%)`
    }
    addEventListener('scroll', () => apply(false), { passive: true })
    addEventListener('resize', () => apply(false))
    image.addEventListener('mouseenter', () => {
      hoverScale = 1.03
      apply(true)
    })
    image.addEventListener('mouseleave', () => {
      hoverScale = 1
      apply(true)
    })
    apply(false)
  }

  const previews = Array.from(document.querySelectorAll<HTMLImageElement>('[data-image-preview]'))
  const heroSet = document.querySelector<HTMLElement>('.hero-set')
  let active: HTMLDivElement | null = null
  let activeImage: HTMLImageElement | null = null
  let closingNode: HTMLDivElement | null = null
  let closingImage: HTMLImageElement | null = null
  let labelEl: HTMLDivElement | null = null

  const updateHeroLayer = () => {
    const previewing = activeImage !== null && activeImage.dataset.imagePreviewCenter !== undefined
    heroSet?.classList.toggle('hero-previewing', previewing)
  }

  const removeActive = (immediate = false) => {
    if (!active) return
    if (immediate) {
      active.remove()
      if (activeImage) activeImage.style.opacity = ''
      labelEl?.remove()
      labelEl = null
      active = null
      activeImage = null
      updateHeroLayer()
      return
    }
    closingNode = active
    closingImage = activeImage
    if (activeImage) activeImage.style.opacity = ''
    labelEl?.remove()
    labelEl = null
    active = null
    activeImage = null
    updateHeroLayer()
    closingNode.classList.add('image-preview-inline-out')
    closingNode.addEventListener('animationend', () => {
      closingNode?.remove()
      closingNode = null
      closingImage = null
    }, { once: true })
  }

  const cancelClose = () => {
    if (!closingNode) return
    closingNode.classList.remove('image-preview-inline-out')
    active = closingNode
    activeImage = closingImage
    if (closingImage) closingImage.style.opacity = '0'
    closingNode = null
    closingImage = null
    updateHeroLayer()
  }

  const isWithin = (x: number, y: number, rect: DOMRect) =>
    x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom

  const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max)

  const previewScaleFor = (width: number) =>
    width >= 900 ? 1.08 : width >= 700 ? 1.5 : width >= 500 ? 1.2 : 1.75

  const positionPreview = (node: HTMLDivElement, image: HTMLImageElement, scale: number, centered: boolean, overlayW: number, overlayH: number) => {
    const rect = image.getBoundingClientRect()
    const vw = window.innerWidth
    const vh = window.innerHeight

    const scaledW = overlayW * scale
    const scaledH = overlayH * scale
    const centerX = rect.left + overlayW / 2
    const centerY = rect.top + overlayH / 2

    const naturalLeft = centerX - scaledW / 2
    const naturalTop = centerY - scaledH / 2

    const targetLeft = centered
      ? (vw - scaledW) / 2
      : scaledW > vw - 32
        ? (vw - scaledW) / 2
        : clamp(naturalLeft, 16, vw - scaledW - 16)
    const targetTop = centered
      ? (vh - scaledH) / 2
      : scaledH > vh - 32
        ? (vh - scaledH) / 2
        : clamp(naturalTop, 16, vh - scaledH - 16)

    node.style.left = `${rect.left}px`
    node.style.top = `${rect.top}px`
    node.style.width = `${overlayW}px`
    node.style.height = `${overlayH}px`
    node.style.setProperty('--preview-tx', `${targetLeft - naturalLeft}px`)
    node.style.setProperty('--preview-ty', `${targetTop - naturalTop}px`)
  }

  const clearClosing = () => {
    if (closingNode) {
      closingNode.remove()
      closingNode = null
      closingImage = null
    }
  }

  const showPreview = (image: HTMLImageElement) => {
    clearClosing()
    const rect = image.getBoundingClientRect()
    if (rect.width === 0 || rect.height === 0) return

    const centered = image.dataset.imagePreviewCenter !== undefined
    const vw = window.innerWidth
    const vh = window.innerHeight

    let overlayW = rect.width
    let overlayH = rect.height
    if (centered && image.naturalWidth > 0) {
      overlayH = rect.width * image.naturalHeight / image.naturalWidth
    }

    let scale = previewScaleFor(rect.width)
    if (centered) {
      scale = Math.max(1.05, Math.min(scale, (vw - 32) / overlayW, (vh - 32) / overlayH))
    }
    activeScale = scale

    const node = document.createElement('div')
    node.className = 'image-preview-inline'
    node.style.setProperty('--preview-scale', scale.toString())
    positionPreview(node, image, scale, centered, overlayW, overlayH)

    const copy = document.createElement('img')
    copy.src = image.currentSrc || image.src
    copy.alt = image.alt || ''
    node.appendChild(copy)

    const label = image.dataset.previewLabel
    if (label) {
      const caption = document.createElement('div')
      caption.className = 'image-preview-label'
      caption.textContent = label
      document.body.appendChild(caption)
      labelEl = caption
    }

    document.body.appendChild(node)
    image.style.opacity = '0'

    active = node
    activeImage = image
    updateHeroLayer()
    positionLabel()
  }

  const positionLabel = () => {
    if (!labelEl || !active || !activeImage) return
    const rect = activeImage.getBoundingClientRect()
    const tx = parseFloat(active.style.getPropertyValue('--preview-tx')) || 0
    const ty = parseFloat(active.style.getPropertyValue('--preview-ty')) || 0
    const overlayW = active.offsetWidth
    const overlayH = active.offsetHeight
    const scaledW = overlayW * activeScale
    const scaledH = overlayH * activeScale
    const centerX = rect.left + overlayW / 2 + tx
    const centerY = rect.top + overlayH / 2 + ty
    const top = centerY + scaledH / 2
    const vh = window.innerHeight
    const y = top + 16 + 36 > vh ? centerY - scaledH / 2 - 46 : top + 16
    labelEl.style.left = `${centerX}px`
    labelEl.style.top = `${y}px`
  }

  let lastX = 0
  let lastY = 0
  let activeScale = 0
  let lastSwitchAt = 0

  const syncActive = () => {
    if (!active || !activeImage) return
    const centered = activeImage.dataset.imagePreviewCenter !== undefined
    const rect = activeImage.getBoundingClientRect()
    let overlayW = rect.width
    let overlayH = rect.height
    if (centered && activeImage.naturalWidth > 0) {
      overlayH = rect.width * activeImage.naturalHeight / activeImage.naturalWidth
    }
    positionPreview(active, activeImage, activeScale, centered, overlayW, overlayH)
    positionLabel()
  }

  const isActiveUnder = (x: number, y: number) => {
    if (!active) return false
    return isWithin(x, y, active.getBoundingClientRect()) ||
      (activeImage !== null && isWithin(x, y, activeImage.getBoundingClientRect()))
  }

  addEventListener('pointermove', (event) => {
    const { clientX: x, clientY: y } = event
    lastX = x
    lastY = y

    if (closingNode && closingImage && isWithin(x, y, closingImage.getBoundingClientRect())) {
      cancelClose()
      return
    }

    const top = document.elementFromPoint(x, y)
    const onActiveLayer = active !== null && top !== null && (top === active || active.contains(top))
    if (onActiveLayer) return

    const other = previews.find((image) =>
      image !== activeImage &&
      isWithin(x, y, image.getBoundingClientRect()) &&
      !onActiveLayer,
    )
    if (other) {
      const now = Date.now()
      if (now - lastSwitchAt > 220) {
        if (active && activeImage !== other) removeActive(true)
        if (!active) showPreview(other)
        lastSwitchAt = now
      }
      return
    }

    if (isActiveUnder(x, y)) return

    const next = previews.find((image) => isWithin(x, y, image.getBoundingClientRect()))
    if (next) {
      const now = Date.now()
      if (now - lastSwitchAt > 220) {
        if (active && activeImage !== next) removeActive(true)
        if (!active) showPreview(next)
        lastSwitchAt = now
      }
    } else {
      removeActive()
    }
  }, { passive: true })

  const isRectInViewport = (rect: DOMRect) =>
    rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth

  addEventListener('scroll', () => {
    if (!active && !closingNode) return
    if (!activeImage) return
    const rect = activeImage.getBoundingClientRect()
    if (!isRectInViewport(rect) || !isWithin(lastX, lastY, rect)) {
      removeActive()
      return
    }
    syncActive()
  }, { passive: true })
  addEventListener('resize', () => {
    if (!active && !closingNode) return
    syncActive()
    if (!isActiveUnder(lastX, lastY)) removeActive()
  })
  addEventListener('blur', () => {
    labelEl?.remove()
    labelEl = null
    if (closingNode) {
      closingNode.remove()
      closingNode = null
      closingImage = null
    }
    removeActive()
  })

  document.querySelectorAll<HTMLElement>('.float-card').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect()
      card.style.setProperty('--ripple-x', `${event.clientX - rect.left}px`)
      card.style.setProperty('--ripple-y', `${event.clientY - rect.top}px`)
    })
  })
</script>

<style>
  .hero-slogan {
    font-family: 'Space Grotesk Variable', 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    font-variation-settings: 'wght' 500;
  }

  .hero-slogan-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.7em;
  }

  .hero-slogan-close {
    color: var(--zinc-400);
  }

  .hero-slogan-close strong {
    color: var(--zinc-100);
    font-variation-settings: 'wght' 650;
  }

  @media (min-width: 1024px) {
    .hero-set {
      width: min(100%, calc((100svh - 500px) * 1.5305));
    }
  }

  .hero-set .hero-scroll-image,
  .hero-set .hero-device {
    transition: box-shadow 300ms ease;
  }

  .hero-set:has(.hero-scroll-image:hover) .hero-device,
  .hero-set:has(.hero-device:hover) .hero-scroll-image {
    box-shadow: 0 24px 64px rgba(56, 189, 248, 0.2);
  }

  .hero-set.hero-previewing .hero-device {
    z-index: 45;
  }

  .hero-device {
    position: absolute;
    z-index: 10;
    overflow: hidden;
    border-radius: 1rem;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
    animation: hero-float 4.4s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }

  .hero-device:hover {
    animation-play-state: paused;
    --hero-scale: 1.06;
    box-shadow: 0 24px 64px rgba(56, 189, 248, 0.25);
  }

  .hero-device-phone {
    left: -2.25rem;
    top: 32%;
    width: 9.5rem;
  }

  .hero-device-pad {
    right: -1.5rem;
    top: 12%;
    width: 16rem;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: rotateX(8deg) rotate(var(--hero-tilt, 0deg)) translateY(0) scale(var(--hero-scale, 1));
    }

    50% {
      transform: rotateX(8deg) rotate(var(--hero-tilt, 0deg)) translateY(-8px) scale(var(--hero-scale, 1));
    }
  }

  @media (min-width: 1280px) {
    .hero-device-phone {
      left: -3.75rem;
      width: 10.5rem;
    }

    .hero-device-pad {
      right: -3.5rem;
      width: 17rem;
    }
  }

  @media (min-width: 1536px) {
    .hero-device-phone {
      left: -5.75rem;
      width: 11rem;
    }

    .hero-device-pad {
      right: -6rem;
      width: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-device {
      animation: none;
    }

    .hero-device:hover {
      transform: rotateX(8deg) rotate(var(--hero-tilt, 0deg)) scale(1.06);
    }
  }

  .pool-waters {
    background-image:
      radial-gradient(70% 45% at 50% 0%, rgba(37, 99, 235, 0.12), transparent 70%),
      radial-gradient(45% 35% at 88% 100%, rgba(14, 165, 233, 0.08), transparent 65%);
  }

  .float-card {
    position: relative;
    overflow: hidden;
    animation: pool-bob 3.6s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
    transition: box-shadow 300ms ease;
  }

  .float-card:hover {
    animation-play-state: paused;
    box-shadow: 0 8px 32px rgba(56, 189, 248, 0.16);
  }

  .float-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(120px circle at var(--ripple-x, 50%) var(--ripple-y, 50%), rgba(56, 189, 248, 0.18), transparent 70%);
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .float-card:hover::before {
    opacity: 1;
  }

  .float-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(circle at var(--ripple-x, 50%) var(--ripple-y, 50%), rgba(125, 211, 252, 0.3), transparent 45%);
    opacity: 0;
    transform-origin: var(--ripple-x, 50%) var(--ripple-y, 50%);
  }

  .float-card:hover::after {
    animation: pool-ripple 700ms ease-out;
  }

  .pool-surface {
    position: relative;
    overflow: hidden;
  }

  .pool-surface::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
