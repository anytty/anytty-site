      panels: ['Shell', 'Agent', '构建日志'], routes: ['Local', 'Direct / Cloud', 'SSH'],
    },
    workbenchPoints: [
      ['不同 endpoint，并排工作', '本地 Shell、远程构建和服务器日志可以同时出现在同一个分屏 workspace 中。'],
