    mobilePoints: [
      ['终端状态一眼看清', '查看运行中的终端和距离上次输出的时间。'],
      ['触控操作顺手', 'Esc、Ctrl、方向键、翻页和常用终端操作都做了触控适配。'],
      ['文件也能管', '浏览、上传、下载和预览远程文件。'],
    ],
    mobileAlts: ['AnyTTY 手机 App 展示终端列表与近期活动', 'AnyTTY 手机 App 使用扩展按键操作终端', 'AnyTTY 手机 App 的远程文件管理器'],
    accessEyebrow: '连接方式', accessTitle: '为每个 endpoint 选择合适的连接方式。',
    accessLead: '先从本地使用开始；已有 SSH 就继续使用 SSH；可达网络可以 Direct 直连；位于 NAT 或内网时，再按需使用 AnyTTY Cloud 的设备发现、P2P 协商和加密 Relay 兜底。',
    accessDiagram: { endpoint: 'Workspace 客户端', routes: ['Local', 'SSH', 'Direct', 'Cloud'], daemon: 'Endpoint daemon' },
    accessPoints: [
      ['Local 与 SSH', '在同一台机器上直接工作，或继续使用已经信任的 OpenSSH 连接，完全不需要 Cloud 服务。'],
