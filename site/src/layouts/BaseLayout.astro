---
import { ArrowDownToLine, Cloud, Languages, Mail, Moon, Sun } from 'lucide-react'

import { GithubIcon } from '@/components/github-icon'
import { canonicalUrl, localizedPath, sitePath, type Locale } from '@/lib/site'
import '@/styles/globals.css'

interface Props {
  locale: Locale
  title?: string
  description: string
  pathname: string
  alternates?: boolean
}

const { locale, title, description, pathname, alternates = true } = Astro.props
const pageTitle = title
  ? `${title} | AnyTTY`
  : locale === 'en' ? 'AnyTTY - Persistent terminals across machines and screens' : 'AnyTTY - 一个工作台，管理每台机器上的持久终端'
const docsPath = localizedPath(locale, '/docs/quick-start')
const homePath = localizedPath(locale)
const alternate = !alternates
  ? localizedPath(locale === 'en' ? 'zh-CN' : 'en')
  : locale === 'en'
    ? (pathname === '/' ? '/zh-CN/' : `/zh-CN${pathname}`)
    : pathname.replace(/^\/zh-CN/, '') || '/'
const labels = locale === 'en'
  ? {
      features: 'Product', screens: 'Clients', docs: 'Docs', download: 'Download', cloud: 'Cloud', language: '中文',
      skip: 'Skip to content', nav: 'Primary navigation', menuTitle: 'Explore AnyTTY',
      menuDescription: 'An open-source, cross-platform terminal multiplexer for persistent sessions across machines.',
      footer: 'Open-source terminals that keep running, so you can come back anytime.', privacy: 'Privacy', terms: 'Terms', security: 'Security', close: 'Close menu',
      theme: 'Toggle theme',
    }
  : {
      features: '产品', screens: '客户端', docs: '文档', download: '下载', cloud: 'Cloud', language: 'English',
      skip: '跳到正文', nav: '主导航', menuTitle: '浏览 AnyTTY',
      menuDescription: '开源跨平台终端复用器，在不同机器之间维护持久会话。',
      footer: '终端一直跑着，随时回来接管的开源工具。', privacy: '隐私政策', terms: '服务条款', security: '安全', close: '关闭菜单',
      theme: '切换主题',
    }

const releaseUrl = 'https://github.com/anytty/anytty-site/releases/tag/v0.0.1-beta.0'
---

<!doctype html>
<html lang={locale} class="dark scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        var root = document.documentElement
        var stored = null
        try { stored = localStorage.getItem('anytty-theme') } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
        root.classList.toggle('dark', dark)
      })()
    </script>
    <link rel="canonical" href={canonicalUrl(pathname)} />
    {alternates && <link rel="alternate" hreflang="en" href={canonicalUrl(locale === 'en' ? pathname : alternate)} />}
    {alternates && <link rel="alternate" hreflang="zh-CN" href={canonicalUrl(locale === 'zh-CN' ? pathname : alternate)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={canonicalUrl(locale === 'en' ? pathname : alternate)} />}
    <link rel="icon" href={sitePath('/assets/app-icon.webp')} />
    <link rel="manifest" href={sitePath('/manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AnyTTY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl(pathname)} />
    <meta property="og:image" content={canonicalUrl('/assets/product/mac-tui.webp')} />
    <meta property="og:image:width" content="1800" />
    <meta property="og:image:height" content="1125" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-background pt-20 text-zinc-50">
    <a
      class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-md bg-foreground px-4 py-3 text-sm text-background shadow-lg transition-transform focus:translate-y-0"
      href="#main"
    >
      {labels.skip}
    </a>
    <header class="fixed inset-x-0 top-0 z-50 pt-4">
      <div class="relative mx-auto flex w-full max-w-7xl items-center justify-center px-5 sm:px-8">
        <a class="group absolute left-0 hidden rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring sm:left-2 sm:block" href={sitePath(homePath)} aria-label="AnyTTY home">
          <span class="inline-flex items-center gap-2.5">
            <img class="size-9 rounded-lg" src={sitePath('/assets/app-icon.webp')} alt="" width="36" height="36" />
            <span class="hidden text-xl font-semibold tracking-tight text-zinc-100 transition-colors group-hover:text-zinc-100/80 sm:inline">AnyTTY</span>
          </span>
        </a>

        <nav class="liquid-glass -translate-x-2 flex items-center gap-0.5 rounded-full p-1 sm:translate-x-0 lg:gap-1" aria-label={labels.nav}>
          <a class="rounded-full px-2 py-1.5 text-[13px] font-medium text-zinc-100 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:shadow-[inset_0_0_0_1px_var(--glass-ring)] sm:px-4 sm:text-sm" href={`${sitePath(homePath)}#how-it-works`}>{labels.features}</a>
          <a class="rounded-full px-2 py-1.5 text-[13px] font-medium text-zinc-100 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:shadow-[inset_0_0_0_1px_var(--glass-ring)] sm:px-4 sm:text-sm" href={`${sitePath(homePath)}#clients`}>{labels.screens}</a>
          <a class="rounded-full px-2 py-1.5 text-[13px] font-medium text-zinc-100 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:shadow-[inset_0_0_0_1px_var(--glass-ring)] sm:px-4 sm:text-sm" href={sitePath(docsPath)}>{labels.docs}</a>
          <a class="inline-flex items-center gap-1.5 rounded-full px-2 py-1.5 text-[13px] font-medium text-zinc-100 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:shadow-[inset_0_0_0_1px_var(--glass-ring)] sm:px-4 sm:text-sm" href={sitePath(localizedPath(locale, '/cloud'))} aria-label={labels.cloud} title={labels.cloud}>
            <Cloud className="size-4" aria-hidden="true" />
            <span class="hidden sm:inline">{labels.cloud}</span>
          </a>
          <a class="ml-0.5 inline-flex items-center gap-1 rounded-full bg-primary px-2.5 py-1.5 text-[13px] font-semibold text-primary-foreground transition-all duration-200 ease-out hover:brightness-110 active:scale-[0.98] sm:ml-1 sm:px-4 sm:text-sm" href={releaseUrl}>
            <ArrowDownToLine className="size-3.5" aria-hidden="true" /><span class="hidden sm:inline">{labels.download}</span>
          </a>
        </nav>

        <div class="absolute right-0 flex items-center gap-0.5 sm:right-2 lg:gap-1">
          <a class="hidden h-9 items-center gap-1.5 rounded-full px-2 text-sm font-medium text-zinc-400 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:text-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:inline-flex lg:px-3" href="https://github.com/anytty/anytty-site" aria-label="GitHub" title="GitHub">
            <GithubIcon className="size-4" aria-hidden="true" />
            <span class="hidden xl:inline">GitHub</span>
          </a>
          <a class="grid size-8 place-items-center rounded-full text-zinc-400 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:text-zinc-100 lg:size-9" href={sitePath(alternate)} lang={locale === 'en' ? 'zh-CN' : 'en'} aria-label={labels.language} title={labels.language}>
            <Languages className="size-4" aria-hidden="true" />
          </a>
          <button type="button" id="theme-toggle" class="grid size-8 place-items-center rounded-full text-zinc-400 transition-all duration-200 ease-out hover:bg-[var(--chip)] hover:text-zinc-100 lg:size-9" aria-label={labels.theme} title={labels.theme}>
            <Sun className="size-4 icon-sun" aria-hidden="true" />
            <Moon className="hidden size-4 icon-moon" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="border-t border-[var(--line)] bg-zinc-950/70 text-zinc-400 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 text-sm sm:px-6 md:flex-row md:items-start md:justify-between lg:px-8">
        <div class="flex items-center gap-3">
          <img class="size-7 rounded-md ring-1 ring-[var(--line-strong)]" src={sitePath('/assets/app-icon.webp')} alt="" width="28" height="28" loading="lazy" />
          <p>&copy; {new Date().getFullYear()} AnyTTY. {labels.footer}</p>
        </div>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-3 md:justify-end" aria-label="Footer">
          <a class="inline-flex items-center gap-1.5 transition-colors hover:text-zinc-100" href="mailto:support@anytty.com">
            <Mail className="size-4" aria-hidden="true" />
            support@anytty.com
          </a>
          <a class="transition-colors hover:text-zinc-100" href={sitePath(localizedPath(locale, '/privacy'))}>{labels.privacy}</a>
          <a class="transition-colors hover:text-zinc-100" href={sitePath(localizedPath(locale, '/terms'))}>{labels.terms}</a>
          <a class="transition-colors hover:text-zinc-100" href="https://github.com/anytty/anytty-site/blob/main/LICENSE">Apache-2.0</a>
          <a class="transition-colors hover:text-zinc-100" href="https://github.com/anytty/anytty-site/security">{labels.security}</a>
        </nav>
      </div>
    </footer>
  </body>
  <script is:inline>
    (function () {
      var root = document.documentElement
      var toggle = document.getElementById('theme-toggle')
      if (!toggle) return
      var sync = function () {
        var dark = root.classList.contains('dark')
        var sun = toggle.querySelector('.icon-sun')
        var moon = toggle.querySelector('.icon-moon')
        if (sun) sun.classList.toggle('hidden', dark)
        if (moon) moon.classList.toggle('hidden', !dark)
      }
      toggle.addEventListener('click', function () {
        var dark = root.classList.toggle('dark')
        try { localStorage.setItem('anytty-theme', dark ? 'dark' : 'light') } catch (e) {}
        sync()
      })
      sync()
    })()
  </script>
</html>
